# Lein - Personal AI Assistant Configuration
# Set these environment variables before using the Lein plugin

# ===================
# Phone Provider
# ===================

# Telnyx: Get these from https://portal.telnyx.com
# - LEIN_PHONE_ACCOUNT_SID = Your Connection ID (from Call Control app)
# - LEIN_PHONE_AUTH_TOKEN = Your API Key (from API Keys section)
# - LEIN_TELNYX_PUBLIC_KEY = Public key for webhook signature verification (Account Settings > Keys & Credentials)
LEIN_PHONE_ACCOUNT_SID=your_connection_id
LEIN_PHONE_AUTH_TOKEN=your_api_key
# LEIN_TELNYX_PUBLIC_KEY=your_public_key  # Optional but recommended for security

# The phone number to call FROM (must be purchased from your provider)
LEIN_PHONE_NUMBER=+1234567890

# ===================
# Your Phone Number
# ===================
# The phone number to call YOU at
LEIN_USER_PHONE_NUMBER=+1234567890

# ===================
# Speech Services
# ===================
# OpenAI API key (required for speech-to-text, and TTS if using openai provider)
LEIN_OPENAI_API_KEY=sk-xxx

# TTS Provider: "openai" (default) or "elevenlabs"
# LEIN_TTS_PROVIDER=openai

# ElevenLabs API key (required if TTS provider is elevenlabs)
# Get from: https://elevenlabs.io/app/settings/api-keys
# LEIN_ELEVENLABS_API_KEY=your_elevenlabs_api_key

# TTS Voice:
# - OpenAI: alloy, echo, fable, onyx (default), nova, shimmer
# - ElevenLabs: voice ID from https://elevenlabs.io/app/voice-library
#   Examples: onwK4e9ZLuTAKqWW03F9 (Daniel), 21m00Tcm4TlvDq8ikWAM (Rachel)
# LEIN_TTS_VOICE=onyx

# TTS Model (optional):
# - OpenAI: tts-1 (default), tts-1-hd
# - ElevenLabs: eleven_multilingual_v2 (default), eleven_turbo_v2_5
# LEIN_TTS_MODEL=

# ===================
# ngrok
# ===================
# Get a free auth token at https://dashboard.ngrok.com/get-started/your-authtoken
LEIN_NGROK_AUTHTOKEN=your_ngrok_authtoken

# Optional: Use a custom ngrok domain (paid feature)
# LEIN_NGROK_DOMAIN=your-domain.ngrok.io

# ===================
# WhatsApp (Kapso)
# ===================
# LEIN_KAPSO_API_KEY=your_kapso_api_key
# LEIN_KAPSO_PHONE_NUMBER_ID=your_phone_number_id

# ===================
# Optional
# ===================
# Local HTTP port for webhooks (default: 3333)
# LEIN_PORT=3333
