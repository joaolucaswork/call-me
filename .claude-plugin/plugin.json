{
  "name": "callme",
  "version": "1.1.0",
  "description": "Claude calls you on the phone when it needs your input or wants to report progress. Supports inbound calls too.",
  "author": {
    "name": "ZeframLou",
    "url": "https://github.com/ZeframLou"
  },
  "repository": "https://github.com/joaolucaswork/call-me",
  "license": "MIT",
  "keywords": ["phone", "voice", "calls", "input", "inbound"],
  "skills": "./skills",
  "mcpServers": {
    "callme": {
      "command": "bun",
      "args": ["run", "--cwd", "${CLAUDE_PLUGIN_ROOT}/server", "start"],
      "env": {
        "CALLME_PHONE_PROVIDER": "${CALLME_PHONE_PROVIDER:-twilio}",
        "CALLME_PHONE_ACCOUNT_SID": "${CALLME_PHONE_ACCOUNT_SID}",
        "CALLME_PHONE_AUTH_TOKEN": "${CALLME_PHONE_AUTH_TOKEN}",
        "CALLME_PHONE_NUMBER": "${CALLME_PHONE_NUMBER}",
        "CALLME_USER_PHONE_NUMBER": "${CALLME_USER_PHONE_NUMBER}",
        "CALLME_OPENAI_API_KEY": "${CALLME_OPENAI_API_KEY}",
        "CALLME_TTS_PROVIDER": "${CALLME_TTS_PROVIDER:-openai}",
        "CALLME_TTS_VOICE": "${CALLME_TTS_VOICE:-onyx}",
        "CALLME_TTS_MODEL": "${CALLME_TTS_MODEL}",
        "CALLME_ELEVENLABS_API_KEY": "${CALLME_ELEVENLABS_API_KEY}",
        "CALLME_NGROK_AUTHTOKEN": "${CALLME_NGROK_AUTHTOKEN}",
        "CALLME_NGROK_DOMAIN": "${CALLME_NGROK_DOMAIN}",
        "CALLME_PORT": "${CALLME_PORT:-3333}",
        "CALLME_TRANSCRIPT_TIMEOUT_MS": "${CALLME_TRANSCRIPT_TIMEOUT_MS:-180000}",
        "CALLME_STT_SILENCE_DURATION_MS": "${CALLME_STT_SILENCE_DURATION_MS:-600}",
        "CALLME_STT_VAD_THRESHOLD": "${CALLME_STT_VAD_THRESHOLD:-0.2}",
        "CALLME_INBOUND_GREETING": "${CALLME_INBOUND_GREETING:-Olá, aqui é o Claude. Como posso ajudar?}",
        "CALLME_HOLD_INTERVAL_MS": "${CALLME_HOLD_INTERVAL_MS:-15000}",
        "CALLME_KAPSO_API_KEY": "${CALLME_KAPSO_API_KEY}",
        "CALLME_KAPSO_PHONE_NUMBER_ID": "${CALLME_KAPSO_PHONE_NUMBER_ID}"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inbound-call-hook.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/whatsapp-status-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/check-pending-call.sh"
          }
        ]
      }
    ]
  }
}
