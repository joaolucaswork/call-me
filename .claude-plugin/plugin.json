{
  "name": "lein",
  "version": "4.0.0",
  "description": "Lein - Personal AI assistant that calls you on the phone and messages via WhatsApp. Supports inbound calls and multi-session spawning.",
  "author": {
    "name": "ZeframLou",
    "url": "https://github.com/ZeframLou"
  },
  "repository": "https://github.com/joaolucaswork/call-me",
  "license": "MIT",
  "keywords": ["phone", "voice", "calls", "whatsapp", "assistant", "lein"],
  "skills": "./skills",
  "mcpServers": {
    "lein": {
      "command": "bun",
      "args": ["run", "--cwd", "${CLAUDE_PLUGIN_ROOT}/server", "start"],
      "env": {
        "LEIN_PHONE_PROVIDER": "${LEIN_PHONE_PROVIDER:-twilio}",
        "LEIN_PHONE_ACCOUNT_SID": "${LEIN_PHONE_ACCOUNT_SID}",
        "LEIN_PHONE_AUTH_TOKEN": "${LEIN_PHONE_AUTH_TOKEN}",
        "LEIN_PHONE_NUMBER": "${LEIN_PHONE_NUMBER}",
        "LEIN_USER_PHONE_NUMBER": "${LEIN_USER_PHONE_NUMBER}",
        "LEIN_OPENAI_API_KEY": "${LEIN_OPENAI_API_KEY}",
        "LEIN_TTS_PROVIDER": "${LEIN_TTS_PROVIDER:-openai}",
        "LEIN_TTS_VOICE": "${LEIN_TTS_VOICE:-onyx}",
        "LEIN_TTS_MODEL": "${LEIN_TTS_MODEL}",
        "LEIN_ELEVENLABS_API_KEY": "${LEIN_ELEVENLABS_API_KEY}",
        "LEIN_NGROK_AUTHTOKEN": "${LEIN_NGROK_AUTHTOKEN}",
        "LEIN_NGROK_DOMAIN": "${LEIN_NGROK_DOMAIN}",
        "LEIN_PORT": "${LEIN_PORT:-3333}",
        "LEIN_TRANSCRIPT_TIMEOUT_MS": "${LEIN_TRANSCRIPT_TIMEOUT_MS:-180000}",
        "LEIN_STT_SILENCE_DURATION_MS": "${LEIN_STT_SILENCE_DURATION_MS:-600}",
        "LEIN_STT_VAD_THRESHOLD": "${LEIN_STT_VAD_THRESHOLD:-0.2}",
        "LEIN_INBOUND_GREETING": "${LEIN_INBOUND_GREETING:-Oi, aqui e a Lein. Como posso ajudar?}",
        "LEIN_HOLD_INTERVAL_MS": "${LEIN_HOLD_INTERVAL_MS:-15000}",
        "LEIN_KAPSO_API_KEY": "${LEIN_KAPSO_API_KEY}",
        "LEIN_KAPSO_PHONE_NUMBER_ID": "${LEIN_KAPSO_PHONE_NUMBER_ID}"
      }
    }
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inbound-call-hook.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/whatsapp-status-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/check-pending-call.sh"
          }
        ]
      }
    ]
  }
}
