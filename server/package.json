{
  "name": "lein",
  "version": "4.0.0",
  "description": "Lein - Personal AI assistant with phone calls and WhatsApp",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "prestart": "bun install --silent",
    "start": "bun run src/index.ts",
    "server": "bun run src/http-server.ts",
    "dev": "pm2 startOrRestart ecosystem.config.cjs && pm2 logs lein",
    "dev:stop": "pm2 stop lein",
    "dev:restart": "pm2 restart lein && pm2 logs lein"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@ngrok/ngrok": "^1.4.1",
    "mem0ai": "^2.2.4",
    "openai": "^4.77.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "bun-types": "latest"
  }
}
